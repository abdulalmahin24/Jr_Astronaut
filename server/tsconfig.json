{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "../src/utils/crewCoopProtocol.ts", "../src/utils/multiplayerMissionService.ts", "../src/utils/multiplayerTransport.ts", "../src/utils/simulationEngine.ts", "../src/utils/radiationScale.ts", "../src/types/game.ts"]
}
